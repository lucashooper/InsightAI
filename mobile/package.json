{
  "name": "mobile",
  "version": "1.14.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "start:clear": "expo start --dev-client -c",
    "test": "vitest run",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:xcode": "open ios/Insight.xcworkspace",
    "ios:dev": "expo start --dev-client --ios",
    "ios:build:dev": "eas build --profile development --platform ios",
    "ios:build:dev:simulator": "eas build --profile development-simulator --platform ios",
    "ios:build:production": "eas build --profile production --platform ios --non-interactive",
    "ios:build:production:submit": "eas build --profile production --platform ios --auto-submit --non-interactive",
    "ios:setup-credentials": "eas credentials:configure-build --platform ios --profile production",
    "ios:submit": "eas submit --platform ios --profile production",
    "ios:update:production": "eas update --channel production",
    "web": "expo start --web",
    "postinstall": "patch-package"
  },
  "dependencies": {
