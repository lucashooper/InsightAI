{
  "cli": {
    "version": ">= 16.27.0",
    "appVersionSource": "local",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "production"
    },
    "investor-apk": {
      "distribution": "internal",
      "channel": "production",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "env": {
        "EXPO_DOCTOR_ENABLE": "0"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "lucashooper100@outlook.com",
        "ascAppId": "6755717396",
        "appleTeamId": "HMLV274G9F"
      }
    }
  }
}